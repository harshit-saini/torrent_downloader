PORT=3000
# Render Postgres connection string (Internal URL when backend is on Render)
DATABASE_URL=postgres://user:pass@localhost:5432/torrents
# Shared password you type on the website
APP_PASSWORD=change-me
# Random long string used to sign login tokens
TOKEN_SECRET=change-me-too
# Frontend origin(s), comma separated. Use * to allow all.
CORS_ORIGIN=http://localhost:5173

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Limits (Render free tier has a small ephemeral disk)
MAX_TORRENT_GB=2
MAX_CONCURRENT=1
DOWNLOAD_DIR=/tmp/torrents
